# Steer Research Studio — environment example
# Copy to .env (backend reads it) and NEVER commit real secrets.

# --- Database ---
# Local development default: SQLite (no setup required).
DATABASE_URL=sqlite:///./steer.db
# Production (Docker Compose sets this automatically):
# DATABASE_URL=postgresql+psycopg://steer:steer@db:5432/steer

# --- Storage ---
UPLOAD_DIR=./data/uploads
GENERATED_DIR=./data/generated

# --- Security ---
# Change this in any real deployment. Used to sign auth tokens.
SECRET_KEY=change-me-to-a-long-random-string

# --- LLM provider (optional) ---
# LLM_PROVIDER=none        -> deterministic rule-based demo generation (clearly labeled)
# LLM_PROVIDER=openai      -> any OpenAI-compatible endpoint (OpenAI, Azure, local vLLM, etc.)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60

# --- Reel rendering ---
# If ffmpeg is on PATH, or imageio-ffmpeg is installed, vertical MP4 reels are rendered.
# Otherwise a clearly-labeled storyboard package is produced instead.
REEL_FPS=24
