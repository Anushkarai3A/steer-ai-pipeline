{
  "$defs": {
    "Slide": {
      "properties": {
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "headline": {
          "maxLength": 140,
          "minLength": 1,
          "title": "Headline",
          "type": "string"
        },
        "body": {
          "default": "",
          "maxLength": 700,
          "title": "Body",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "visual_direction": {
          "default": "",
          "title": "Visual Direction",
          "type": "string"
        },
        "footnote": {
          "default": "",
          "title": "Footnote",
          "type": "string"
        }
      },
      "required": [
        "index",
        "headline"
      ],
      "title": "Slide",
      "type": "object"
    },
    "SourceNote": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "text"
      ],
      "title": "SourceNote",
      "type": "object"
    }
  },
  "properties": {
    "concept": {
      "default": "",
      "title": "Concept",
      "type": "string"
    },
    "audience": {
      "default": "",
      "title": "Audience",
      "type": "string"
    },
    "main_message": {
      "default": "",
      "title": "Main Message",
      "type": "string"
    },
    "slides": {
      "items": {
        "$ref": "#/$defs/Slide"
      },
      "title": "Slides",
      "type": "array"
    },
    "caption": {
      "default": "",
      "title": "Caption",
      "type": "string"
    },
    "hashtags": {
      "items": {
        "type": "string"
      },
      "title": "Hashtags",
      "type": "array"
    },
    "source_notes": {
      "items": {
        "$ref": "#/$defs/SourceNote"
      },
      "title": "Source Notes",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "disclaimer": {
      "default": "",
      "title": "Disclaimer",
      "type": "string"
    }
  },
  "title": "CarouselPayload",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
